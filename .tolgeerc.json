{
  "$schema": "https://json.schemastore.org/tolgeerc",
  "projectId": 2,
  "format": "JSON_TOLGEE",
  "push": {
    "files": [
      { "path": "pkg/i18n/translations/en.json", "language": "en", "namespace": "i18n" }
    ],
    "forceMode": "OVERRIDE"
  },
  "pull": {
    "path": ".",
    "languages": ["ru"],
    "namespaces": ["i18n"],
    "fileStructureTemplate": "pkg/{namespace}/translations/{languageTag}.json"
  }
}
